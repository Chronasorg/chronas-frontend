{
  "name": "chronas-frontend",
  "version": "0.1.0",
  "description": "Modern React 19 frontend shell for Chronas - Interactive Historical Map Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert deployment",
    "test:e2e:ui": "playwright test --ui --grep-invert deployment",
    "test:deploy": "playwright test --config=playwright.deploy.config.ts tests/e2e/deployment.spec.ts",
    "test:deploy:staging": "DEPLOY_ENV=staging playwright test --config=playwright.deploy.config.ts tests/e2e/deployment.spec.ts",
    "test:deploy:prod": "DEPLOY_ENV=production playwright test --config=playwright.deploy.config.ts tests/e2e/deployment.spec.ts",
    "test:deploy:unit": "playwright test --config=playwright.deploy.config.ts",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:staging": "tsx scripts/deploy.ts staging",
    "deploy:prod": "tsx scripts/deploy.ts production",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run test && npm run build",
    "ci:full": "npm run lint && npm run test && npm run test:e2e && npm run build",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/geo-layers": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/mapbox": "^9.3.6",
    "@deck.gl/react": "^9.3.6",
    "@testing-library/dom": "^10.4.1",
    "@turf/turf": "^7.3.3",
    "axios": "^1.18.1",
    "i18next": "^26.3.6",
    "immutable": "^5.1.9",
    "mapbox-gl": "^3.26.0",
    "moment": "^2.30.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-map-gl": "^8.1.0",
    "react-router": "^8.3.0",
    "vis-data": "^8.0.3",
    "vis-timeline": "^8.5.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "chronas",
    "history",
    "map",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Chronas Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronas/chronas-frontend.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
